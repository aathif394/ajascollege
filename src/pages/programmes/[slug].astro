---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const programmes = await getCollection("programmes", ({ data }) => !data.draft);
  return programmes.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, "") },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const levelLabel =
  entry.data.level === "ug"
    ? "UG (Honours)"
    : entry.data.level === "pg"
      ? "PG"
      : entry.data.level;
const hasMeta =
  entry.data.department || entry.data.duration || entry.data.seats || entry.data.level;
const body = ((entry as { body?: string }).body || "").trim();
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  pageTitle={entry.data.title}
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Programmes", href: "/programmes/" },
    { label: entry.data.title },
  ]}
>
  <div class="prog-detail-wrap">
    <article class="prog-detail-card">
      <header class="prog-detail-head">
        <span class="prog-detail-level">{levelLabel}</span>
        <h1>{entry.data.title}</h1>
        {
          entry.data.description && (
            <p class="prog-detail-desc">{entry.data.description}</p>
          )
        }
      </header>

      {
        hasMeta && (
          <dl class="prog-detail-facts">
            <div>
              <dt>Level</dt>
              <dd>{levelLabel}</dd>
            </div>
            {entry.data.department && (
              <div>
                <dt>Department</dt>
                <dd>{entry.data.department}</dd>
              </div>
            )}
            {entry.data.duration && (
              <div>
                <dt>Duration</dt>
                <dd>{entry.data.duration}</dd>
              </div>
            )}
            {entry.data.seats && (
              <div>
                <dt>Seats</dt>
                <dd>{entry.data.seats}</dd>
              </div>
            )}
          </dl>
        )
      }

      {
        body && (
          <div class="prog-detail-body ajas-prose">
            <Content />
          </div>
        )
      }

      <footer class="prog-detail-foot">
        <a href="/programmes/">← All programmes</a>
        <div>
          <a href="/admission/">Apply</a>
          <a href="/fees/">Fees</a>
        </div>
      </footer>
    </article>
  </div>
</BaseLayout>

<style>
  .prog-detail-wrap {
    padding: 28px 16px 56px;
    background: linear-gradient(180deg, #f0f3f8 0%, #f8fafc 35%, #fff 100%);
  }
  .prog-detail-card {
    max-width: 820px;
    margin: 0 auto;
    background: #fff;
    border-radius: 12px;
    padding: 28px 24px 32px;
    box-shadow: 0 10px 36px rgba(24, 50, 81, 0.08);
    border-top: 4px solid #3f4c99;
  }
  @media (min-width: 768px) {
    .prog-detail-card {
      padding: 36px 40px 40px;
    }
  }
  .prog-detail-level {
    display: inline-block;
    background: #183251;
    color: #fff;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 999px;
    margin-bottom: 12px;
  }
  .prog-detail-head h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.45rem, 2.5vw, 1.85rem);
    color: #183251;
    line-height: 1.25;
  }
  .prog-detail-desc {
    margin: 0;
    color: #64748b;
    font-size: 1.02rem;
    line-height: 1.55;
  }
  .prog-detail-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 12px;
    margin: 1.5rem 0 0;
    padding: 1rem 0 0;
    border-top: 1px solid #e8eef4;
  }
  .prog-detail-facts div {
    background: #f7f9fc;
    border-radius: 8px;
    padding: 12px 14px;
  }
  .prog-detail-facts dt {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #94a3b8;
    font-weight: 600;
    margin: 0 0 4px;
  }
  .prog-detail-facts dd {
    margin: 0;
    font-weight: 600;
    color: #183251;
    font-size: 0.98rem;
  }
  .prog-detail-body {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid #e8eef4;
  }
  .prog-detail-foot {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid #e8eef4;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
    justify-content: space-between;
    align-items: center;
  }
  .prog-detail-foot a {
    font-weight: 600;
    color: #3f4c99;
    text-decoration: none;
  }
  .prog-detail-foot a:hover {
    color: #ff5f60;
  }
  .prog-detail-foot div {
    display: flex;
    gap: 16px;
  }
  .prog-detail-foot div a {
    font-weight: 500;
    color: #64748b;
  }
</style>
