---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const news = (await getCollection("news", ({ data }) => !data.draft)).sort((a, b) => {
  const da = a.data.date ? +new Date(a.data.date) : 0;
  const db = b.data.date ? +new Date(b.data.date) : 0;
  return db - da || a.data.title.localeCompare(b.data.title);
});
---

<BaseLayout
  title="News"
  description="Campus news from Al Jamia Arts & Science College."
  pageTitle="News"
>
  <div class="blog-bl content-blog blog-single">
    <div class="container">
      <p class="listing-intro">
        Announcements, achievements and campus happenings from Al Jamia Arts &amp; Science College.
      </p>
      <div class="row">
        {
          news.map((n) => (
            <div class="col-lg-4 col-md-6 col-sm-12">
              <article class="ajas-card">
                <a class="ajas-card-media" href={n.data.permalink}>
                  {n.data.image ? (
                    <img src={n.data.image} alt="" loading="lazy" />
                  ) : (
                    <div class="ajas-card-ph" />
                  )}
                </a>
                <div class="ajas-card-body">
                  {n.data.date && (
                    <time datetime={new Date(n.data.date).toISOString()}>
                      {new Date(n.data.date).toLocaleDateString("en-IN", {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                      })}
                    </time>
                  )}
                  <h2>
                    <a href={n.data.permalink}>{n.data.title}</a>
                  </h2>
                  <a class="ajas-card-more" href={n.data.permalink}>
                    Read more <i class="fa fa-long-arrow-right" aria-hidden="true" />
                  </a>
                </div>
              </article>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .listing-intro {
    max-width: 36rem;
    margin: 0 0 1.75rem;
    color: #5c6578;
    font-size: 1.05rem;
  }
  .ajas-card {
    margin-bottom: 28px;
    background: #fff;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 6px 22px rgba(24, 50, 81, 0.08);
    height: calc(100% - 28px);
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .ajas-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 32px rgba(24, 50, 81, 0.12);
  }
  .ajas-card-media {
    background: #eef2f7;
    min-height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ajas-card-media img {
    display: block;
    width: 100%;
    max-height: 300px;
    height: auto;
    object-fit: contain;
    background: #eef2f7;
  }
  .ajas-card-ph {
    width: 100%;
    height: 190px;
    background: linear-gradient(135deg, #183251, #3f4c99);
  }
  .ajas-card-body {
    padding: 16px 18px 18px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .ajas-card-body time {
    font-size: 0.78rem;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .ajas-card-body h2 {
    font-size: 1.08rem;
    margin: 8px 0 12px;
    line-height: 1.35;
    flex: 1;
  }
  .ajas-card-body h2 a {
    color: #183251;
    text-decoration: none;
  }
  .ajas-card-body h2 a:hover {
    color: #ff5f60;
  }
  .ajas-card-more {
    font-size: 0.88rem;
    font-weight: 600;
    color: #ff5f60;
    text-decoration: none;
  }
  .ajas-card-more i {
    margin-left: 4px;
  }
</style>
