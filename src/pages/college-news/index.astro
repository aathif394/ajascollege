---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const news = (await getCollection("news", ({ data }) => !data.draft)).sort((a, b) => {
  const da = a.data.date ? +new Date(a.data.date) : 0;
  const db = b.data.date ? +new Date(b.data.date) : 0;
  return db - da || a.data.title.localeCompare(b.data.title);
});
---

<BaseLayout
  title="News"
  description="Campus news from Al Jamia Arts & Science College."
  pageTitle="News"
>
  <div class="blog-bl content-blog blog-single">
    <div class="container">
      <p class="listing-intro">
        Announcements, achievements and campus happenings. Staff: publish under <strong>News</strong>{" "}
        in the CMS.
      </p>
      <div class="row">
        {
          news.map((n) => (
            <div class="col-lg-4 col-md-6 col-sm-12">
              <article class="ajas-news-card">
                <a class="ajas-news-thumb" href={n.data.permalink}>
                  {n.data.image ? (
                    <img src={n.data.image} alt="" />
                  ) : (
                    <div class="ajas-news-ph" />
                  )}
                </a>
                <div class="ajas-news-body">
                  {n.data.date && (
                    <time datetime={new Date(n.data.date).toISOString()}>
                      {new Date(n.data.date).toLocaleDateString("en-IN", {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                      })}
                    </time>
                  )}
                  <h2>
                    <a href={n.data.permalink}>{n.data.title}</a>
                  </h2>
                  <a class="ajas-readmore" href={n.data.permalink}>
                    Read more
                  </a>
                </div>
              </article>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .ajas-news-card {
    margin-bottom: 28px;
    background: #fff;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 18px rgba(24, 50, 81, 0.08);
  }
  .ajas-news-thumb img,
  .ajas-news-ph {
    display: block;
    width: 100%;
    height: 180px;
    object-fit: cover;
    background: #e5e7eb;
  }
  .ajas-news-body {
    padding: 14px 16px 18px;
  }
  .ajas-news-body time {
    font-size: 0.8rem;
    color: #64748b;
  }
  .ajas-news-body h2 {
    font-size: 1.05rem;
    margin: 6px 0 10px;
    line-height: 1.35;
  }
  .ajas-readmore {
    font-size: 0.9rem;
    color: #ff5f60;
    font-weight: 600;
  }
</style>
