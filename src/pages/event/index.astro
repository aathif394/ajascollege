---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const events = (await getCollection("events", ({ data }) => !data.draft)).sort((a, b) => {
  const da = a.data.date ? +new Date(a.data.date) : 0;
  const db = b.data.date ? +new Date(b.data.date) : 0;
  return db - da || a.data.title.localeCompare(b.data.title);
});
---

<BaseLayout
  title="Events"
  description="Events at Al Jamia Arts & Science College."
  pageTitle="Events"
>
  <div class="blog-bl content-blog blog-single">
    <div class="container">
      <p class="listing-intro">Campus events, programmes and outreach activities.</p>
      <div class="row">
        {
          events.map((e) => (
            <div class="col-lg-4 col-md-6 col-sm-12">
              <article class="ajas-card">
                <a class="ajas-card-media" href={e.data.permalink}>
                  {e.data.image ? (
                    <img src={e.data.image} alt="" loading="lazy" />
                  ) : (
                    <div class="ajas-card-ph" />
                  )}
                  <span class="ajas-card-badge">Event</span>
                </a>
                <div class="ajas-card-body">
                  {e.data.date && (
                    <time datetime={new Date(e.data.date).toISOString()}>
                      {new Date(e.data.date).toLocaleDateString("en-IN", {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                      })}
                    </time>
                  )}
                  <h2>
                    <a href={e.data.permalink}>{e.data.title}</a>
                  </h2>
                  <a class="ajas-card-more" href={e.data.permalink}>
                    View details <i class="fa fa-long-arrow-right" aria-hidden="true" />
                  </a>
                </div>
              </article>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .listing-intro {
    max-width: 36rem;
    margin: 0 0 1.75rem;
    color: #5c6578;
    font-size: 1.05rem;
  }
  .ajas-card {
    margin-bottom: 28px;
    background: #fff;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 6px 22px rgba(24, 50, 81, 0.08);
    height: calc(100% - 28px);
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .ajas-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 32px rgba(24, 50, 81, 0.12);
  }
  .ajas-card-media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #eef2f7;
    min-height: 220px;
  }
  .ajas-card-media img {
    display: block;
    width: 100%;
    max-height: 320px;
    height: auto;
    object-fit: contain; /* full poster, no crop */
    background: #eef2f7;
  }
  .ajas-card-ph {
    width: 100%;
    height: 190px;
    background: linear-gradient(135deg, #183251, #3f4c99);
  }
  .ajas-card-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: #ff5f60;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 999px;
  }
  .ajas-card-body {
    padding: 16px 18px 18px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .ajas-card-body time {
    font-size: 0.78rem;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .ajas-card-body h2 {
    font-size: 1.08rem;
    margin: 8px 0 12px;
    line-height: 1.35;
    flex: 1;
  }
  .ajas-card-body h2 a {
    color: #183251;
    text-decoration: none;
  }
  .ajas-card-body h2 a:hover {
    color: #ff5f60;
  }
  .ajas-card-more {
    font-size: 0.88rem;
    font-weight: 600;
    color: #ff5f60;
    text-decoration: none;
  }
</style>
