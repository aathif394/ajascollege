const addOnCourses = [
  "Fundamental Digital Literacy and Data Skills (ASAP)",
  "Human Behaviour (SWAYAM)",
  "Certificate in Content Writing and Proof Reading (Keltron)",
  "Cyber Security (Keltron)",
  "Data Analytics (Keltron)",
