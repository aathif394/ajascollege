const pgProgrammes = [
  { name: "M.Sc Psychology", eligibility: "BA/BA (Honours)/B.Sc with Psychology core", fee: "25,200" },
  { name: "MA Islamic Finance", eligibility: "Any UG degree with at least 50% CGPA", fee: "21,000" },
  { name: "MA Arabic Language and Literature", eligibility: "BA Arabic/Afsalul Ulama/Double main with Arabic/BA Functional Arabic/BA/B.Sc with Arabic as common course, ≥50% CGPA", fee: "21,000" },
