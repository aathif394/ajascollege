  { name: "Dr. Nahas Mala", role: "Executive Member" },
  { name: "Dr. Abdul Basith PP", role: "Executive Member" },
  { name: "Dr. ZA Ashraf", role: "Executive Member" },
  { name: "Sulaiman Oorakam", role: "Executive Member" },
  { name: "Yusuf KP Pallikkooth", role: "Executive Member" },
  { name: "Ummer M Pooppalam", role: "Executive Member" },
