  { name: "Bachelors of Computer Application (BCA)", eligibility: "+2 or equivalent with Mathematics/Computer Science/Computer Application/IT/Informatics/Additional Mathematics as one of the subjects", fee: "21,000" },
  { name: "B.Sc Microbiology", eligibility: "+2 or equivalent with Physics, Chemistry and Biology", fee: "21,840" },
  { name: "B.Sc Food Technology", eligibility: "+2 or equivalent with Science and Mathematics", fee: "21,840" },
  { name: "B.Sc Psychology", eligibility: "+2 or equivalent with 45% marks", fee: "12,600" },
  { name: "B.Sc Geography", eligibility: "+2 or equivalent", fee: "12,600" },
  { name: "B.Com (Computer Application)", eligibility: "+2 or equivalent with at least one commerce subject; non-commerce +2 with ≥45% also eligible", fee: "12,600" },
