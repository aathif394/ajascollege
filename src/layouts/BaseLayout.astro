---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SearchModal from "../components/SearchModal.astro";

interface Props {
  title: string;
  description?: string;
  variant?: "home" | "inner";
  pageTitle?: string;
  breadcrumbs?: { label: string; href?: string }[];
}

const {
  title,
  description = "Al Jamia Arts & Science College, Perinthalmanna — affiliated to the University of Calicut.",
  variant = "inner",
  pageTitle,
  breadcrumbs = [],
} = Astro.props;

const fullTitle =
  title === "Home"
    ? "Home | Al Jamia Arts & Science College"
    : `${title} | Al Jamia Arts & Science College`;

const crumbs =
  breadcrumbs.length > 0
    ? breadcrumbs
    : pageTitle
      ? [
          { label: "Home", href: "/" },
          { label: pageTitle },
        ]
      : [];

/** Non-critical CSS — load without blocking first paint */
const deferredStyles = [
  "/stylesheet/themify-icons.css",
  "/stylesheet/animate.css",
  "/stylesheet/jquery-fancybox.css",
  "/stylesheet/flexslider.css",
  "/stylesheet/owl.theme.default.min.css",
  "/stylesheet/owl.carousel.min.css",
  "/stylesheet/jquery.mCustomScrollbar.min.css",
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    {/* Allow pinch-zoom — do not use maximum-scale=1 / user-scalable=no */}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/icon/favicon.ico" />

    {/* Fonts: preconnect + single family (Rubik). No CSS @import. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700&display=swap"
      />
    </noscript>

    {/* Critical CSS — needed for first paint / layout */}
    <link rel="stylesheet" href="/stylesheet/bootstrap.css" />
    <link rel="stylesheet" href="/stylesheet/font-awesome.css" />
    <link rel="stylesheet" href="/stylesheet/style.css" />
    <link rel="stylesheet" href="/stylesheet/shortcodes.css" />
    <link rel="stylesheet" href="/stylesheet/responsive.css" />
    <link rel="stylesheet" href="/assets/migrate.css" />

    {/* Deferred CSS — carousels, fancybox, animation extras */}
    {
      deferredStyles.map((href) => (
        <>
          <link rel="stylesheet" href={href} media="print" onload="this.media='all'" />
          <noscript>
            <link rel="stylesheet" href={href} />
          </noscript>
        </>
      ))
    }
  </head>
  <body>
    <div id="loading-overlay"><div class="loader"></div></div>

    {
      variant === "home" ? (
        <Header variant="home" />
      ) : (
        <Header variant="inner">
          <Fragment slot="page-title">
            {pageTitle && (
              <div class="page-title page-title-blog">
                <div class="page-title-inner">
                  <div class="breadcrumbs breadcrumbs-blog text-left">
                    <div class="container">
                      <div class="breadcrumbs-wrap">
                        <ul class="breadcrumbs-inner">
                          {crumbs.map((c, i) => (
                            <li class={i === crumbs.length - 1 ? "active" : undefined}>
                              {c.href && i < crumbs.length - 1 ? (
                                <a href={c.href}>{c.label}</a>
                              ) : (
                                c.label
                              )}
                            </li>
                          ))}
                        </ul>
                        <h1 class="title">{pageTitle}</h1>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            )}
          </Fragment>
        </Header>
      )
    }

    {/* Pagefind indexes only main content, not chrome */}
    <main data-pagefind-body>
      <slot />
    </main>

    <Footer />
    <SearchModal />
  </body>
</html>
