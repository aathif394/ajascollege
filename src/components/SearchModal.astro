---
/**
 * Site search — Pagefind Component UI (custom elements), not the deprecated
 * Default UI (pagefind-ui.js). Assets loaded once in Footer.astro; these
 * elements auto-upgrade on parse, share the implicit "default" instance, and
 * need no init script — <pagefind-modal> uses a native <dialog> (Escape +
 * focus trap for free), and <pagefind-modal-trigger> handles the Ctrl/Cmd+K
 * shortcut itself.
 */
---

<pagefind-config bundle-path="/pagefind/" preload></pagefind-config>

<pagefind-modal-trigger
  class="ajas-search-trigger"
  placeholder="Search the site"
  title="Search (Ctrl/⌘ K)"
  compact
  hide-shortcut
></pagefind-modal-trigger>

<pagefind-modal reset-on-close>
  <pagefind-modal-header>
    <div class="ajas-search-brand">
      <span class="ajas-search-brand-mark"></span>
      <div>
        <strong>Search</strong>
        <span>Al Jamia Arts &amp; Science College</span>
      </div>
    </div>
  </pagefind-modal-header>
  <pagefind-modal-body>
    <pagefind-input placeholder="Search the site…" autofocus show-sub-results></pagefind-input>
    <pagefind-summary default-message="Start typing to search the site."></pagefind-summary>
    <pagefind-results show-images="false"></pagefind-results>
  </pagefind-modal-body>
</pagefind-modal>

<style is:global>
  /* Custom elements render their raw light-DOM children until the browser
     upgrades them (customElements.define runs) — without this, "Search /
     Al Jamia Arts & Science College" sits as plain flowed text wherever
     <pagefind-modal> lives in the document until/unless the script loads. */
  pagefind-modal:not(:defined),
  pagefind-modal-header:not(:defined),
  pagefind-modal-body:not(:defined),
  pagefind-input:not(:defined),
  pagefind-summary:not(:defined),
  pagefind-results:not(:defined),
  pagefind-modal-trigger:not(:defined) {
    display: none;
  }

  /* ========== FAB: search above Edukin #scroll-top ========== */
  .ajas-search-trigger {
    display: block;
    position: fixed;
    right: 20px;
    bottom: 78px; /* clears #scroll-top */
    z-index: 9990;
  }
  .ajas-search-trigger .pf-trigger-btn {
    width: 50px;
    height: 50px;
    border: 0;
    border-radius: 50%;
    background: linear-gradient(150deg, #183251, #3f4c99);
    box-shadow: 0 10px 26px rgba(24, 50, 81, 0.32);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s cubic-bezier(0.2, 0.7, 0.3, 1), box-shadow 0.2s ease;
  }
  .ajas-search-trigger .pf-trigger-btn:hover {
    transform: translateY(-2px) scale(1.05);
    box-shadow: 0 14px 32px rgba(24, 50, 81, 0.4);
  }
  .ajas-search-trigger .pf-trigger-btn:focus-visible {
    outline: 2px solid #c4a35a;
    outline-offset: 3px;
  }
  .ajas-search-trigger .pf-trigger-icon {
    width: 17px;
    height: 17px;
    background: #fff;
  }

  /* Keep go-top aligned under search, coral so the pair reads as one stack */
  #scroll-top {
    right: 25px !important;
    bottom: 22px !important;
    width: 42px !important;
    height: 42px !important;
    line-height: 42px !important;
    border-radius: 50% !important;
    background: linear-gradient(150deg, #ff5f60, #e6484f) !important;
    box-shadow: 0 8px 20px rgba(230, 72, 79, 0.35) !important;
    z-index: 9980 !important;
    overflow: hidden;
    transition: transform 0.2s cubic-bezier(0.2, 0.7, 0.3, 1) !important;
  }
  #scroll-top:hover {
    background: linear-gradient(150deg, #ff5f60, #e6484f) !important;
    transform: translateY(-2px) scale(1.05);
  }

  /* ========== Pagefind Component UI theming ========== */
  pagefind-modal {
    --pf-font: Rubik, system-ui, -apple-system, "Segoe UI", sans-serif;
    --pf-text: #2c3e50;
    --pf-text-secondary: #5c6578;
    --pf-text-muted: #8b96a8;
    --pf-background: #fff;
    --pf-border: #dbe3ee;
    --pf-border-focus: #7a1f2b;
    --pf-hover: #f7f9fc;
    --pf-mark: #7a1f2b;
    --pf-border-radius: 8px;
    --pf-modal-backdrop: rgba(9, 24, 42, 0.62);
    --pf-modal-max-width: 640px;
    --pf-modal-top: max(8vh, 24px);
    --pf-input-font-size: 16px;
    --pf-result-title-font-size: 15px;
    --pf-result-excerpt-font-size: 13px;
    --pf-summary-font-size: 13px;
  }
  dialog.pf-modal {
    border-radius: 16px;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.28);
  }
  dialog.pf-modal::backdrop {
    backdrop-filter: blur(2px);
  }
  .pf-modal-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    background: linear-gradient(90deg, #183251 0%, #1e3a6e 55%, #7a1f2b 160%);
    color: #fff;
  }
  .ajas-search-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  .ajas-search-brand-mark {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #c4a35a;
    flex-shrink: 0;
  }
  .ajas-search-brand strong {
    display: block;
    font-family: Rubik, system-ui, sans-serif;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.2;
  }
  .ajas-search-brand span {
    display: block;
    font-size: 11px;
    opacity: 0.8;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 42vw;
  }
  .pf-modal-header .pf-modal-close {
    color: #fff;
    background: rgba(255, 255, 255, 0.12);
  }
  .pf-modal-header .pf-modal-close:hover {
    background: rgba(255, 255, 255, 0.22);
  }
  .pf-modal-body {
    padding: 14px 16px 20px;
  }
  .pf-input {
    background: #f8fafc;
  }
  .pf-summary {
    color: #5c6578;
    padding: 4px 2px 10px;
  }
  .pf-result-link {
    font-weight: 600;
  }
  .pf-result-excerpt {
    line-height: 1.45;
  }
  .pf-result-excerpt mark {
    background: #fde8ec;
    padding: 0 2px;
    border-radius: 2px;
  }

  @media (max-width: 520px) {
    .ajas-search-trigger {
      right: 14px;
      bottom: 68px;
    }
    .ajas-search-trigger .pf-trigger-btn {
      width: 44px;
      height: 44px;
    }
    pagefind-modal {
      --pf-modal-top: 12px;
    }
  }
</style>
