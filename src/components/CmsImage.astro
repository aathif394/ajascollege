---
/**
 * Optimized CMS image via Astro built-in Image + Sharp.
 * Accepts Sveltia public paths like /assets/uploads/2024/05/photo.jpg
 */
import { Image } from "astro:assets";
import {
  resolveCmsImage,
  type OptimizePreset,
} from "../lib/cmsImage";

interface Props {
  src?: string | null;
  alt?: string;
  preset?: OptimizePreset;
  class?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
  widths?: number[];
  sizes?: string;
  width?: number;
  /** object-fit for constrained layout */
  fit?: "cover" | "contain" | "fill" | "none" | "scale-down";
}

const {
  src,
  alt = "",
  preset = "card",
  class: className,
  loading = "lazy",
  fetchpriority,
  widths: widthsProp,
  sizes: sizesProp,
  width: widthProp,
  fit = "cover",
} = Astro.props;

const meta = src ? await resolveCmsImage(src) : null;

const presetDefaults: Record<
  OptimizePreset,
  { widths: number[]; sizes: string; width: number }
> = {
  card: {
    widths: [320, 480, 640, 800],
    sizes: "(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 360px",
    width: 640,
  },
  hero: {
    widths: [640, 960, 1280, 1600],
    sizes: "100vw",
    width: 1280,
  },
  poster: {
    widths: [480, 720, 960, 1200],
    sizes: "(max-width: 768px) 100vw, 720px",
    width: 960,
  },
  avatar: {
    widths: [120, 200, 320, 400],
    sizes: "(max-width: 768px) 40vw, 200px",
    width: 320,
  },
  inline: {
    widths: [480, 720, 960, 1200],
    sizes: "(max-width: 768px) 100vw, 720px",
    width: 960,
  },
  logo: {
    widths: [160, 240, 320],
    sizes: "200px",
    width: 240,
  },
};

const d = presetDefaults[preset];
const widths = widthsProp ?? d.widths;
const sizes = sizesProp ?? d.sizes;
const width = widthProp ?? d.width;
---

{
  meta ? (
    <Image
      src={meta}
      alt={alt}
      widths={widths}
      sizes={sizes}
      width={Math.min(width, meta.width)}
      format="webp"
      quality={preset === "logo" ? 85 : 75}
      loading={loading}
      fetchpriority={fetchpriority}
      class={className}
      layout="constrained"
      fit={fit}
      decoding="async"
    />
  ) : src ? (
    <img
      src={src}
      alt={alt}
      class={className}
      loading={loading}
      decoding="async"
      fetchpriority={fetchpriority}
    />
  ) : null
}
