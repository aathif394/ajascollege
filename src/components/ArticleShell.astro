---
/**
 * Content page shell — overview, about, IQAC, etc.
 * Prose + media/tables styled to feel intentional, not bare markdown.
 */
interface Props {
  wide?: boolean;
  /** Visual variant for content type */
  variant?: "default" | "profile" | "info" | "listing";
}

const { wide = false, variant = "default" } = Astro.props;
const outer = wide
  ? "blog-single content-blog ajas-page-shell is-wide"
  : "blog-single content-blog narrow-page ajas-page-shell";
---

<div class={outer} data-variant={variant}>
  <div class="container">
    <div class={wide ? "row" : "row justify-content-center"}>
      <div class={wide ? "col-lg-12" : "col-lg-10 col-xl-9"}>
        <div class="ajas-page-card">
          <div class="site-content clearfix">
            <article class="post post-blog-single">
              <div class="content-blog-single-wrap migrate-content ajas-prose">
                <slot />
              </div>
            </article>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  .ajas-page-shell {
    padding: 28px 0 56px;
    background: linear-gradient(180deg, #f0f3f8 0%, #f8fafc 35%, #fff 100%);
  }
  .ajas-page-card {
    background: #fff;
    border-radius: 12px;
    padding: 28px 22px 36px;
    box-shadow: 0 10px 36px rgba(24, 50, 81, 0.08);
  }
  @media (min-width: 768px) {
    .ajas-page-card {
      padding: 40px 44px 48px;
    }
  }

  /* ——— Prose designed for college content ——— */
  .ajas-prose {
    font-size: 16.5px;
    line-height: 1.75;
    color: #2c3e50;
  }
  .ajas-prose > :first-child {
    margin-top: 0;
  }
  .ajas-prose h1,
  .ajas-prose h2,
  .ajas-prose h3,
  .ajas-prose h4 {
    margin: 1.5em 0 0.55em;
    line-height: 1.28;
    font-weight: 600;
    color: #183251;
    letter-spacing: -0.02em;
  }
  .ajas-prose h1 {
    font-size: 1.7rem;
    margin-top: 0;
    padding-bottom: 0.45em;
    border-bottom: 3px solid #ff5f60;
  }
  .ajas-prose h2 {
    font-size: 1.32rem;
    border-left: 4px solid #ff5f60;
    padding-left: 12px;
  }
  .ajas-prose h3 {
    font-size: 1.12rem;
    color: #3f4c99;
  }
  .ajas-prose p {
    margin: 0 0 1.05em;
  }
  .ajas-prose ul,
  .ajas-prose ol {
    margin: 0 0 1.15em;
    padding-left: 1.35em;
  }
  .ajas-prose li {
    margin: 0.35em 0;
  }
  /* Full images / posters — never crop */
  .ajas-prose img {
    max-width: 100%;
    width: auto;
    height: auto;
    max-height: none;
    object-fit: contain;
    display: block;
    margin: 1.1em auto 1.4em;
    border-radius: 6px;
    box-shadow: 0 8px 28px rgba(24, 50, 81, 0.1);
    background: #f8fafc;
  }
  /* Figure-style: single lead image + caption */
  .ajas-prose p:has(> img:only-child) {
    text-align: center;
    background: #f4f6fa;
    padding: 16px;
    border-radius: 10px;
    margin: 1.25em 0;
  }
  .ajas-prose p:has(> img:only-child) img {
    margin: 0 auto;
    box-shadow: 0 6px 20px rgba(24, 50, 81, 0.1);
  }
  /* Photo galleries: 2+ consecutive image-only paragraphs lay out as a grid tile,
     not a stack of full-width boxes one after another. */
  .ajas-prose p:has(> img:only-child):has(+ p:has(> img:only-child)),
  .ajas-prose p:has(> img:only-child) + p:has(> img:only-child) {
    display: inline-block;
    width: calc(33.333% - 10px);
    box-sizing: border-box;
    vertical-align: top;
    margin: 0 10px 10px 0;
    padding: 8px;
  }
  .ajas-prose p:has(> img:only-child):has(+ p:has(> img:only-child)) img,
  .ajas-prose p:has(> img:only-child) + p:has(> img:only-child) img {
    width: 100%;
    height: 160px;
    object-fit: cover;
    margin: 0;
  }
  @media (max-width: 640px) {
    .ajas-prose p:has(> img:only-child):has(+ p:has(> img:only-child)),
    .ajas-prose p:has(> img:only-child) + p:has(> img:only-child) {
      width: calc(50% - 8px);
    }
  }
  .ajas-prose a {
    color: #3f4c99;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .ajas-prose a:hover {
    color: #ff5f60;
    border-bottom-color: #ff5f60;
  }
  /* Fact tables (overview, IQAC, rosters) */
  .ajas-prose table {
    width: 100%;
    margin: 1.25em 0 1.5em;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.95rem;
    overflow: hidden;
    border-radius: 8px;
    box-shadow: 0 2px 12px rgba(24, 50, 81, 0.06);
  }
  .ajas-prose th,
  .ajas-prose td {
    border: 1px solid #e8eef4;
    padding: 0.7em 1em;
    text-align: left;
    vertical-align: top;
  }
  .ajas-prose th {
    background: #183251;
    color: #fff;
    font-weight: 600;
  }
  .ajas-prose tr:nth-child(even) td {
    background: #f8fafc;
  }
  .ajas-prose tr:hover td {
    background: #eef2ff;
  }
  /* 2-col fact tables: first cell as label */
  .ajas-prose table td:first-child {
    font-weight: 600;
    color: #183251;
    width: 38%;
    background: #f0f4f9;
  }
  .ajas-prose table th:first-child {
    width: auto;
  }
  .ajas-prose blockquote {
    margin: 1.25em 0;
    padding: 0.85em 1.15em;
    border-left: 4px solid #ff5f60;
    background: #fff8f8;
    color: #475569;
    border-radius: 0 8px 8px 0;
  }
  .ajas-prose hr {
    border: 0;
    height: 1px;
    background: linear-gradient(90deg, #ff5f60, #3f4c99);
    opacity: 0.35;
    margin: 2em 0;
  }
  .ajas-prose strong {
    color: #183251;
  }
  /* Programme / fee style lists under headings */
  .ajas-prose h3 + ul {
    background: #f8fafc;
    border: 1px solid #e8eef4;
    border-radius: 8px;
    padding: 0.85em 0.85em 0.85em 1.6em;
    list-style: none;
  }
  .ajas-prose h3 + ul li {
    padding: 0.25em 0;
    border-bottom: 1px solid #eef2f7;
  }
  .ajas-prose h3 + ul li:last-child {
    border-bottom: 0;
  }
</style>
