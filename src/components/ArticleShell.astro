---
/**
 * Shared Edukin content chrome. Editorial content is pure Markdown from the CMS.
 */
interface Props {
  /** Extra class on outer blog-single wrapper */
  wide?: boolean;
}

const { wide = false } = Astro.props;
const outer = wide
  ? "blog-single content-blog"
  : "blog-single content-blog narrow-page";
---

<div class={outer}>
  <div class="container">
    {
      wide ? (
        <div class="row">
          <div class="col-lg-12">
            <div class="site-content clearfix">
              <article class="post post-blog-single">
                <div class="content-blog-single">
                  <div class="content-blog-single-inner">
                    <div class="content-blog-single-wrap migrate-content ajas-prose">
                      <slot />
                    </div>
                  </div>
                </div>
              </article>
            </div>
          </div>
        </div>
      ) : (
        <div class="row justify-content-center">
          <div class="col-lg-9">
            <div class="site-content clearfix">
              <article class="post post-blog-single">
                <div class="content-blog-single">
                  <div class="content-blog-single-inner">
                    <div class="content-blog-single-wrap migrate-content ajas-prose">
                      <slot />
                    </div>
                  </div>
                </div>
              </article>
            </div>
          </div>
        </div>
      )
    }
  </div>
</div>

<style is:global>
  /* Readable prose for Markdown output inside Edukin */
  .ajas-prose {
    font-size: 16px;
    line-height: 1.7;
    color: #2c3e50;
  }
  .ajas-prose > :first-child {
    margin-top: 0;
  }
  .ajas-prose h1,
  .ajas-prose h2,
  .ajas-prose h3,
  .ajas-prose h4 {
    margin: 1.4em 0 0.55em;
    line-height: 1.25;
    font-weight: 600;
    color: #183251;
  }
  .ajas-prose h1 {
    font-size: 1.75rem;
  }
  .ajas-prose h2 {
    font-size: 1.4rem;
  }
  .ajas-prose h3 {
    font-size: 1.15rem;
  }
  .ajas-prose p {
    margin: 0 0 1em;
  }
  .ajas-prose ul,
  .ajas-prose ol {
    margin: 0 0 1em;
    padding-left: 1.35em;
  }
  .ajas-prose li {
    margin: 0.25em 0;
  }
  .ajas-prose img {
    max-width: 100%;
    height: auto;
    border-radius: 4px;
    margin: 0.75em 0 1.25em;
  }
  .ajas-prose a {
    color: #3f4c99;
  }
  .ajas-prose a:hover {
    color: #ff5f60;
  }
  .ajas-prose table {
    width: 100%;
    margin: 1em 0;
    border-collapse: collapse;
  }
  .ajas-prose th,
  .ajas-prose td {
    border: 1px solid #e5e7eb;
    padding: 0.5em 0.75em;
    text-align: left;
  }
  .ajas-prose blockquote {
    margin: 1em 0;
    padding: 0.5em 1em;
    border-left: 4px solid #ff5f60;
    background: #f8fafc;
    color: #475569;
  }
</style>
