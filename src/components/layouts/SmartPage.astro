---
/**
 * Content-aware page layout — not a wall of text.
 * Sections → cards, tables → fact grids, programmes → programme cards.
 */
import {
  splitSections,
  parseProgrammes,
  looksLikeAdmission,
  looksLikeVision,
  type FactRow,
  type ContentSection,
  type DataTable as DataTableType,
} from "../../lib/parseContent";
import { optimizeHtmlImages } from "../../lib/cmsImage";
import CmsImage from "../CmsImage.astro";
import AttachmentList from "../AttachmentList.astro";
import DataTable from "../DataTable.astro";

interface Props {
  title: string;
  body: string;
  permalink: string;
  image?: string;
  attachments?: { label: string; file: string }[];
}

const { title, body, permalink, image, attachments } = Astro.props;

const isAdmission = looksLikeAdmission(body, permalink);
const isVision = looksLikeVision(body, title, permalink);
const parsed = splitSections(body);
const programmes = isAdmission ? parseProgrammes(body) : null;

// If page starts with ## Title (no loose intro), pull facts from first section to the top
let introHtml = parsed.introHtml;
let introFacts = [...parsed.introFacts];
let introTables = [...parsed.introTables];
let sections = [...parsed.sections];
let introImages = [...parsed.introImages];

if (!introHtml && !introFacts.length && !introTables.length && sections.length > 0) {
  const first = sections[0];
  if (first.facts.length >= 2) {
    introFacts = first.facts;
    introTables = first.tables;
    introHtml = first.bodyHtml;
    introImages = [...introImages, ...first.images];
    sections = sections.slice(1);
  }
}

// Deliberately narrow: only labels whose value is reliably a short number
// (a year, a count) belong in a big colored stat tile. Descriptive facts
// like "Place", "State" or "Affiliated university" read fine in the fact
// sheet but look broken blown up as a tile ("Poopalam, Perinthalmanna" in
// giant digits-style type) — same failure mode as the sentence-length
// stat tiles this heuristic originally existed to prevent.
const statKeys = [
  "year of established",
  "year of establishment",
  "established",
  "no of programs",
  "no. of programs",
  "number of programs",
];
const highlightStats = introFacts.filter((f) => {
  const l = f.label.toLowerCase();
  return statKeys.some((k) => l.includes(k)) && f.value.length <= 20;
});
const statsForStrip = highlightStats.length >= 2 ? highlightStats.slice(0, 4) : [];

// Optimize any remaining inline images in HTML fragments
introHtml = introHtml ? await optimizeHtmlImages(introHtml, "inline") : introHtml;
sections = await Promise.all(
  sections.map(async (s) => ({
    ...s,
    bodyHtml: s.bodyHtml ? await optimizeHtmlImages(s.bodyHtml, "inline") : s.bodyHtml,
  })),
);
const progLead = programmes?.leadHtml
  ? await optimizeHtmlImages(programmes.leadHtml, "inline")
  : programmes?.leadHtml;
const progTail = programmes?.tailHtml
  ? await optimizeHtmlImages(programmes.tailHtml, "inline")
  : programmes?.tailHtml;
---

<div class="smart-page">
  {/* ——— Vision & Mission: two equal panels (image + text each) ——— */}
  {
    isVision && (
      <div class="sp-vision">
        <div class="sp-vision-grid">
          {parsed.sections.map((s, i) => {
            const imgSrc =
              s.images[0] ||
              (i === 0 ? image || parsed.introImages[0] : undefined) ||
              (i === 1 ? parsed.introImages[1] : undefined);
            return (
              <section class={`sp-vision-card ${i % 2 === 1 ? "sp-vision-card-b" : ""}`} id={s.id}>
                {imgSrc ? (
                  <figure class="sp-vision-card-fig">
                    <CmsImage src={imgSrc} alt={s.title} preset="inline" fit="contain" />
                  </figure>
                ) : (
                  <span class="sp-vision-card-ico">
                    <i class={`fa ${i % 2 === 1 ? "fa-bullseye" : "fa-eye"}`} aria-hidden="true" />
                  </span>
                )}
                <div class="sp-vision-card-body">
                  <h2>{s.title}</h2>
                  <div class="sp-html" set:html={s.bodyHtml} />
                </div>
              </section>
            );
          })}
        </div>
      </div>
    )
  }

  {/* ——— Admission: programme cards ——— */}
  {
    isAdmission && programmes && (
      <div class="sp-admission">
        {progLead && (
          <div class="sp-lead sp-html" set:html={progLead} />
        )}
        <div class="sp-prog-grid">
          {programmes.programmes.map((p) => (
            <article class="sp-prog-card">
              <h3>{p.title}</h3>
              <ul class="sp-prog-meta">
                {p.duration && (
                  <li>
                    <span>Duration</span>
                    <strong>{p.duration}</strong>
                  </li>
                )}
                {p.fee && (
                  <li>
                    <span>Fee</span>
                    <strong>{p.fee}</strong>
                  </li>
                )}
                {p.intake && (
                  <li>
                    <span>Intake</span>
                    <strong>{p.intake}</strong>
                  </li>
                )}
              </ul>
              {p.complementary && (
                <p class="sp-prog-comp">
                  <em>Complementary:</em> {p.complementary}
                </p>
              )}
              {p.eligibility && (
                <div class="sp-prog-elig">
                  <strong>Eligibility</strong>
                  <p>{p.eligibility}</p>
                </div>
              )}
              {p.extraHtml && <div class="sp-html" set:html={p.extraHtml} />}
            </article>
          ))}
        </div>
        {progTail && (
          <div class="sp-tail sp-html" set:html={progTail} />
        )}
      </div>
    )
  }

  {/* ——— Default / overview: hero + facts + section cards ——— */}
  {
    !isVision && !isAdmission && (
      <div class="sp-default">
        {(image || introImages[0]) && (
          <figure class="sp-hero-fig">
            <CmsImage
              src={image || introImages[0]}
              alt=""
              preset="hero"
              fit="contain"
              loading="eager"
            />
          </figure>
        )}

        {statsForStrip.length > 0 && (
          <div class="sp-stats">
            {statsForStrip.map((s) => (
              <div class="sp-stat">
                <span class="sp-stat-val">{s.value}</span>
                <span class="sp-stat-lbl">{s.label}</span>
              </div>
            ))}
          </div>
        )}

        <div class={`sp-top ${introFacts.length ? "has-facts" : ""}`}>
          {introHtml && (
            <div class="sp-lead-card">
              <h2 class="sp-kicker">{title}</h2>
              <div class="sp-html" set:html={introHtml} />
            </div>
          )}
          {introFacts.length > 0 && (
            <aside class="sp-fact-sheet">
              <h3>At a glance</h3>
              <dl>
                {introFacts.map((r) => (
                  <div class="sp-fact-row">
                    <dt>{r.label}</dt>
                    <dd>{r.value}</dd>
                  </div>
                ))}
              </dl>
            </aside>
          )}
        </div>

        {introTables.length > 0 && (
          <div class="sp-tables">
            {introTables.map((t) => (
              <DataTable table={t} />
            ))}
          </div>
        )}

        {sections.length > 0 && (
          <div class="sp-sections">
            {sections.map((s: ContentSection, i: number) => (
              <section
                class:list={["sp-section", i % 2 === 1 && "sp-section-alt"]}
                id={s.id}
              >
                <div class="sp-section-head">
                  <span class="sp-section-num">{String(i + 1).padStart(2, "0")}</span>
                  <h2>{s.title}</h2>
                </div>
                {s.images.length > 0 && (
                  <div class="sp-section-gallery">
                    {s.images.map((src) => (
                      <CmsImage src={src} alt="" preset="inline" fit="contain" />
                    ))}
                  </div>
                )}
                {s.facts.length > 0 && (
                  <dl class="sp-mini-facts">
                    {s.facts.map((r) => (
                      <div class="sp-fact-row">
                        <dt>{r.label}</dt>
                        <dd>{r.value}</dd>
                      </div>
                    ))}
                  </dl>
                )}
                {s.tables.length > 0 &&
                  s.tables.map((t) => <DataTable table={t} />)}
                {s.bodyHtml && <div class="sp-html" set:html={s.bodyHtml} />}
              </section>
            ))}
          </div>
        )}

        {attachments && attachments.length > 0 && (
          <div class="sp-section">
            <AttachmentList items={attachments} />
          </div>
        )}
      </div>
    )
  }
</div>

<style>
  .smart-page {
    padding: 0 0 64px;
    background: #f0f3f8;
  }

  /* —— shared HTML inside sections —— */
  .sp-html :global(p) {
    margin: 0 0 0.95em;
    line-height: 1.75;
    color: #2c3e50;
  }
  .sp-html :global(p:last-child) {
    margin-bottom: 0;
  }
  .sp-html :global(ul),
  .sp-html :global(ol) {
    margin: 0 0 1em;
    padding-left: 1.25em;
  }
  .sp-html :global(img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 1em auto;
    border-radius: 8px;
  }
  .sp-html :global(a) {
    color: #3f4c99;
    font-weight: 500;
  }

  /* —— Vision: balanced two columns, each image + text —— */
  .sp-vision {
    max-width: 1100px;
    margin: 0 auto;
    padding: 40px 16px 8px;
  }
  .sp-vision-grid {
    display: grid;
    gap: 22px;
    align-items: stretch;
  }
  @media (min-width: 800px) {
    .sp-vision-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .sp-vision-card {
    background: linear-gradient(160deg, #183251, #28477a);
    border-radius: 18px;
    box-shadow: 0 18px 40px rgba(24, 50, 81, 0.16);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    height: 100%;
  }
  .sp-vision-card-b {
    background: linear-gradient(160deg, #ff5f60, #e6484f);
  }
  .sp-vision-card-ico {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.14);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 22px;
    margin: 28px 0 0 28px;
  }
  .sp-vision-card-fig {
    margin: 0;
    padding: 20px 20px 0;
    background: rgba(255, 255, 255, 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 200px;
  }
  .sp-vision-card-fig img {
    max-width: 100%;
    max-height: 280px;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }
  .sp-vision-card-body {
    padding: 18px 28px 32px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .sp-vision-card h2 {
    margin: 0 0 0.85rem;
    font-size: 1.45rem;
    color: #fff;
  }
  .sp-vision-card .sp-html {
    flex: 1;
    font-size: 1.05rem;
  }
  .sp-vision-card .sp-html :global(p) {
    color: rgba(255, 255, 255, 0.88);
    line-height: 1.7;
  }

  /* —— Admission programmes —— */
  .sp-admission {
    max-width: 1120px;
    margin: 0 auto;
    padding: 28px 16px 0;
  }
  .sp-prog-grid {
    display: grid;
    gap: 18px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px) {
    .sp-prog-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1000px) {
    .sp-prog-grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }
  .sp-prog-card {
    background: #fff;
    border-radius: 12px;
    padding: 22px 20px 24px;
    box-shadow: 0 8px 28px rgba(24, 50, 81, 0.08);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .sp-prog-card h3 {
    margin: 0;
    font-size: 1.1rem;
    color: #183251;
    line-height: 1.3;
  }
  .sp-prog-meta {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .sp-prog-meta li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 10px;
    background: #f4f6fa;
    border-radius: 8px;
    font-size: 0.9rem;
  }
  .sp-prog-meta span {
    color: #64748b;
  }
  .sp-prog-meta strong {
    color: #183251;
    text-align: right;
  }
  .sp-prog-elig {
    font-size: 0.88rem;
    color: #475569;
    border-top: 1px solid #eef2f7;
    padding-top: 10px;
  }
  .sp-prog-elig strong {
    display: block;
    color: #3f4c99;
    margin-bottom: 4px;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .sp-prog-comp {
    font-size: 0.88rem;
    color: #5c6578;
    margin: 0;
  }
  .sp-lead,
  .sp-tail {
    background: #fff;
    border-radius: 12px;
    padding: 20px 22px;
    margin-bottom: 20px;
    box-shadow: 0 6px 20px rgba(24, 50, 81, 0.06);
  }
  .sp-tail {
    margin-top: 20px;
    margin-bottom: 0;
  }

  /* —— Default / overview —— */
  .sp-default {
    max-width: 1100px;
    margin: 0 auto;
    padding: 28px 16px 0;
  }
  .sp-hero-fig {
    margin: 0 0 22px;
    background: #fff;
    border-radius: 12px;
    padding: 12px;
    box-shadow: 0 10px 32px rgba(24, 50, 81, 0.08);
    display: flex;
    justify-content: center;
  }
  .sp-hero-fig img {
    max-width: 100%;
    max-height: 420px;
    height: auto;
    object-fit: contain;
    border-radius: 6px;
  }
  .sp-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-bottom: 22px;
  }
  @media (min-width: 700px) {
    .sp-stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .sp-stat {
    background: #183251;
    color: #fff;
    border-radius: 12px;
    padding: 18px 14px;
    text-align: center;
  }
  .sp-stat:nth-child(2) {
    background: #3f4c99;
  }
  .sp-stat:nth-child(3) {
    background: #7a1f2b;
  }
  .sp-stat:nth-child(4) {
    background: #1e3a6e;
  }
  .sp-stat-val {
    display: block;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.25;
    margin-bottom: 6px;
  }
  .sp-stat-lbl {
    display: block;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    opacity: 0.85;
  }
  .sp-top {
    display: grid;
    gap: 18px;
    margin-bottom: 22px;
  }
  @media (min-width: 900px) {
    .sp-top.has-facts {
      grid-template-columns: 1.35fr 1fr;
      align-items: start;
    }
  }
  .sp-lead-card,
  .sp-fact-sheet,
  .sp-section {
    background: #fff;
    border-radius: 12px;
    padding: 26px 24px 28px;
    box-shadow: 0 10px 32px rgba(24, 50, 81, 0.07);
  }
  .sp-kicker {
    margin: 0 0 0.85rem;
    font-size: 1.35rem;
    color: #183251;
    border-left: 4px solid #ff5f60;
    padding-left: 12px;
  }
  .sp-fact-sheet h3 {
    margin: 0 0 14px;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #3f4c99;
  }
  .sp-fact-sheet dl,
  .sp-mini-facts {
    margin: 0;
  }
  .sp-fact-row {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 10px;
    padding: 10px 0;
    border-bottom: 1px solid #eef2f7;
  }
  .sp-fact-row:last-child {
    border-bottom: 0;
  }
  .sp-fact-row dt {
    margin: 0;
    font-size: 0.82rem;
    font-weight: 600;
    color: #64748b;
  }
  .sp-fact-row dd {
    margin: 0;
    font-size: 0.92rem;
    font-weight: 500;
    color: #183251;
    text-align: right;
  }
  .sp-tables {
    margin-bottom: 22px;
  }
  .sp-sections {
    display: grid;
    gap: 16px;
  }
  .sp-section-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 12px;
  }
  .sp-section-num {
    font-size: 0.75rem;
    font-weight: 700;
    color: #ff5f60;
    letter-spacing: 0.06em;
  }
  .sp-section h2 {
    margin: 0;
    font-size: 1.25rem;
    color: #183251;
  }
  .sp-section-alt {
    background: #f7f9fc;
  }
  .sp-section-gallery {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 14px;
    justify-content: center;
  }
  .sp-section-gallery img {
    max-width: min(100%, 360px);
    max-height: 320px;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    background: #f4f6fa;
  }
  .sp-mini-facts {
    margin-bottom: 12px;
    background: #f8fafc;
    border-radius: 8px;
    padding: 4px 14px;
  }
</style>
