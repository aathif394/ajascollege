---
/**
 * Full-width responsive table for content too big/irregular to squeeze into
 * the compact "at a glance" fact sheet (committee lists, report archives,
 * multi-column report grids). Cells are raw markdown (links etc.), rendered
 * inline — see lib/parseContent.ts DataTable type.
 */
import { marked } from "marked";
import type { DataTable as DataTableType } from "../lib/parseContent";

interface Props {
  table: DataTableType;
}

const { table } = Astro.props;

const renderCell = (cell: string) =>
  cell ? (marked.parseInline(cell, { async: false }) as string) : "";
---

<div class="dt-wrap">
  <table class="dt-table">
    {
      table.headers.length > 0 && (
        <thead>
          <tr>
            {table.headers.map((h) => <th set:html={renderCell(h)} />)}
          </tr>
        </thead>
      )
    }
    <tbody>
      {
        table.rows.map((row) => (
          <tr>
            {row.map((cell) => (
              <td set:html={renderCell(cell)} />
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .dt-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid #eef2f7;
    border-radius: 10px;
    margin: 0 0 1em;
  }
  .dt-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }
  .dt-table th,
  .dt-table td {
    padding: 10px 14px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid #eef2f7;
    white-space: normal;
  }
  .dt-table thead th {
    background: #f4f6fa;
    color: #183251;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 700;
    white-space: nowrap;
  }
  .dt-table tbody tr:last-child td {
    border-bottom: 0;
  }
  .dt-table tbody tr:nth-child(even) {
    background: #fafbfd;
  }
  .dt-table :global(a) {
    color: #3f4c99;
    font-weight: 600;
  }
  .dt-table :global(a:hover) {
    color: #ff5f60;
  }
</style>
