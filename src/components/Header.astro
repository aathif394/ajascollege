---
import headerHtml from "../partials/header.html?raw";
import { getSiteSettings } from "../lib/site";

interface Props {
  variant?: "home" | "inner";
}

const { variant = "inner" } = Astro.props;
const isHome = variant === "home";
const site = await getSiteSettings();

// Inject live contact + admission from Site settings (CMS)
let html = headerHtml;
const phoneDisplay = site.phone_display || site.phone;
const phoneHref = site.phone.startsWith("+") || site.phone.startsWith("0")
  ? `tel:${site.phone.replace(/\s/g, "")}`
  : `tel:${site.phone}`;

html = html.replace(
  /href="tel:[^"]*"[^>]*>[^<]*/g,
  `href="${phoneHref}">${phoneDisplay}`,
);
html = html.replace(
  /href="mailto:[^"]*"[^>]*>[^<]*/g,
  `href="mailto:${site.email}">${site.email}`,
);
if (site.logo) {
  html = html.replace(
    /src="\/assets\/uploads\/2024\/01\/AJAS-Website-Heading-Last\.svg"/,
    `src="${site.logo}"`,
  );
}
---

{
  isHome ? (
    <div class="wrap-header">
      <div class="flat-header flat-header-style2 ajas-home-header">
        <Fragment set:html={html} />
      </div>
    </div>
  ) : (
    <div class="bg-header">
      <div class="flat-header-blog">
        <Fragment set:html={html} />
        <slot name="page-title" />
      </div>
    </div>
  )
}

{
  site.admission_open && (
    <div class="ajas-admit-strip" role="status">
      <div class="container">
        <a href={site.admission_url || "/admission/"}>
          <strong>{site.admission_label || "Admissions open"}</strong>
          {site.admission_note && <span> — {site.admission_note}</span>}
        </a>
        {site.fee_pdf && (
          <>
            {" · "}
            <a href={site.fee_pdf} target="_blank" rel="noopener">
              Fee structure
            </a>
          </>
        )}
        {" · "}
        <a href="/notices/">Notices</a>
      </div>
    </div>
  )
}

<style is:global>
  .ajas-admit-strip {
    background: #183251;
    color: #fff;
    font-size: 14px;
    padding: 8px 0;
    text-align: center;
  }
  .ajas-admit-strip a {
    color: #fff;
    text-decoration: none;
  }
  .ajas-admit-strip a:hover {
    color: #ffbe34;
  }
  .ajas-admit-strip strong {
    color: #ffbe34;
  }
</style>
